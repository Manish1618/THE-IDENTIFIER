# ==========================================================
# Hackathon Prototype Environment Configuration
# ==========================================================

# 1. SerpApi (Google Lens Engine) - https://serpapi.com (100 free searches/mo)
SERPAPI_API_KEY=your_serpapi_key_here

# 2. Google Cloud Vision API / Google Gemini API (Multimodal AI)
#    - Gemini API: https://aistudio.google.com or https://console.developers.google.com
#    - Cloud Vision API: https://console.cloud.google.com/apis
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Pinata IPFS - https://pinata.cloud (Free 1GB IPFS Pinning)
PINATA_JWT=your_pinata_jwt_token_here

# 4. Polygon Amoy Testnet RPC & Chain ID
# Faucets: https://faucet.polygon.technology/ or https://www.alchemy.com/faucets/polygon-amoy
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_CHAIN_ID=80002

# 5. Polygon Amoy Wallet & Deployed Contract
PRIVATE_KEY=your_metamask_testnet_private_key
CONTRACT_ADDRESS=0x_deployed_contract_address_here

# 6. Hackathon Failsafe Mode
# Set to 'true' to use realistic mock data if offline or API keys are not supplied
DEMO_MODE=false

